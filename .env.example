# Copy to .env and fill in what you use. Every AI key below has a free tier;
# set as many as you like and LabForge fails over between them in AI_PROVIDERS order.

# cloud = use the providers below; local = offline mode for development (only
# reads sheets that already contain code, no API calls)
AI_MODE=cloud
# Fastest first. When one is slow (AI_HEDGE_SECONDS) the next starts too; first good answer wins.
AI_PROVIDERS=cerebras,groq,gemini,sambanova,openrouter,nvidia,cloudflare,mistral,github,zai,huggingface,cohere,deepseek
# AI_TIMEOUT_SECONDS=90
# AI_HEDGE_SECONDS=12
AI_MAX_OUTPUT_TOKENS=12000

# Google AI Studio  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=
GEMINI_MAX_ATTEMPTS=2
# low | medium | high, or a token budget like 512. Low keeps thinking tokens near zero.
GEMINI_THINKING=low

# Cloudflare Workers AI through your own proxy Worker (deploy/cloudflare-ai/README.md).
# Free plan: 10,000 neurons a day, about 30 sheets.
CLOUDFLARE_AI_KEY=
CLOUDFLARE_BASE_URL=
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# gpt-oss reasoning effort on Groq, Cerebras and Cloudflare: low | medium | high
AI_REASONING_EFFORT=low

# Cerebras (fastest, free)  https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Groq (very fast, free)  https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# SambaNova Cloud (free)  https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# OpenRouter (models ending in :free)  https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# NVIDIA NIM (free developer access)  https://build.nvidia.com
NVIDIA_API_KEY=
# Mistral (free "Experiment" plan)  https://console.mistral.ai
MISTRAL_API_KEY=
# GitHub Models (a fine-grained token with models:read)  https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=
# Z.ai (GLM Flash models are free)  https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# Hugging Face Inference Providers (small monthly credit)  https://huggingface.co/settings/tokens
HF_INFERENCE_TOKEN=
# Cohere (trial key, about 1,000 calls a month)  https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# DeepSeek (not free, but costs a fraction of a cent per sheet)  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Any of them: <NAME>_MODEL and <NAME>_BASE_URL override the defaults, e.g. NVIDIA_MODEL=...

# Postgres for everything that must survive a restart and be shared by every instance:
# the draft cache, rate limits and the activity log (e.g. a free Neon database).
# LABFORGE_LOG_DB_URL still works as the old name.
LABFORGE_DATABASE_URL=

# Public address of the site, used in sitemap.xml and canonical links (e.g. https://labforge.in).
LABFORGE_PUBLIC_URL=

# Limits per browser (anonymous id) and, larger, per IP address. Sheets that were written before
# are free and don't count.
LABFORGE_AI_DAILY_LIMIT=10
# LABFORGE_AI_DAILY_PER_IP=60
# Re-running the server's own code (any input) vs. running changed code.
# LABFORGE_RUNS_PER_HOUR=30
# LABFORGE_EDITED_RUNS_PER_HOUR=10
# LABFORGE_EXPLAIN_DAILY_LIMIT=20
# Changed shell scripts are never run unless this is 1 (not recommended on a public site).
# LABFORGE_ALLOW_EDITED_SHELL=0
# Reports written at the same time; the rest wait in a queue.
# LABFORGE_MAX_ACTIVE_DRAFTS=4
LABFORGE_JOB_TTL_HOURS=24
LABFORGE_MAX_UPLOAD_MB=8
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For.
LABFORGE_TRUST_PROXY=0
# Enables the /admin activity panel and GET /api/admin/usage?token=... Leave empty to disable.
LABFORGE_ADMIN_TOKEN=
# Activity log (which reports were made, which programs failed). Goes to LABFORGE_DATABASE_URL,
# otherwise to artifacts/activity.jsonl (lost on every restart on hosts with a wiped disk).
# Names and UIDs are not stored and IPs are hashed unless LABFORGE_LOG_PERSONAL=1 (the privacy
# page says which, automatically).
LABFORGE_LOG_DAYS=14
LABFORGE_LOG_PERSONAL=0
# Salt for hashed IPs (defaults to the admin token).
# LABFORGE_LOG_SALT=

# Error reports (https://sentry.io, free tier). Leave empty to turn off.
SENTRY_DSN=

# Running student programs. local = subprocess with a scrubbed environment;
# docker = one locked-down container per run (no network);
# remote = send every program to the execution worker (apps/worker) on another machine.
# Use remote (or docker) for a public site: see docs/deployment.md.
EXEC_BACKEND=local
# For EXEC_BACKEND=remote: the worker's address and a shared random token (24+ characters).
EXEC_WORKER_URL=
EXEC_WORKER_TOKEN=
LABFORGE_EXECUTION_TIMEOUT_SECONDS=12
# Allow web pages being screenshotted to load things from the internet (off: SSRF risk).
HTML_ALLOW_NETWORK=0

# PDF: auto uses Gotenberg if GOTENBERG_URL is set, else a local LibreOffice.
PDF_BACKEND=auto
GOTENBERG_URL=
PDF_CONVERSION_TIMEOUT_SECONDS=120

# AdSense publisher id, for /ads.txt (same value as the VITE_ADSENSE_CLIENT build argument).
ADSENSE_CLIENT=

# Android app (Trusted Web Activity), once it exists: served at /.well-known/assetlinks.json.
ANDROID_APP_PACKAGE=
ANDROID_APP_SHA256=

# Build-time settings for the frontend (Docker build args, or apps/frontend/.env for npm run build):
# VITE_ADSENSE_CLIENT=ca-pub-...   VITE_ADSENSE_SLOT_RAIL=...   VITE_ADSENSE_SLOT_BENCH=...
# VITE_CONTACT_EMAIL=you@example.com   (shown on the privacy and terms pages: required for AdSense)
# VITE_SENTRY_DSN=...                  (browser error reports, optional)
# VITE_CF_BEACON_TOKEN=...             (Cloudflare Web Analytics, cookieless, optional)

# Search engines and AI assistants (docs/seo.md). The creator shown on the site and in structured data.
LABFORGE_AUTHOR_NAME=Mohammad Taha
LABFORGE_AUTHOR_AFFILIATION=Chandigarh University
# Your profiles, comma-separated (LinkedIn, GitHub, portfolio): they tie your name to LabForge.
# Set the same value as the VITE_AUTHOR_LINKS build argument so the creator page lists them too.
LABFORGE_AUTHOR_LINKS=
LABFORGE_REPO_URL=https://github.com/SHZunknown11/Lab-Forge
