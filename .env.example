# Copy to .env and fill in what you use. Every AI key below has a free tier;
# set as many as you like and LabForge fails over between them in AI_PROVIDERS order.

# cloud = use the providers below; local = offline mode for development (only
# reads sheets that already contain code, no API calls)
AI_MODE=cloud
AI_PROVIDERS=gemini,cloudflare,groq,cerebras,openrouter,mistral,github
AI_MAX_OUTPUT_TOKENS=12000

# Google AI Studio  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=
GEMINI_MAX_ATTEMPTS=2
# low | medium | high, or a token budget like 512. Low keeps thinking tokens near zero.
GEMINI_THINKING=low

# Cloudflare Workers AI through your own proxy Worker (deploy/cloudflare-ai/README.md).
# Free plan: 10,000 neurons a day, about 30 sheets.
CLOUDFLARE_AI_KEY=
CLOUDFLARE_BASE_URL=
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# gpt-oss reasoning effort on Groq, Cerebras and Cloudflare: low | medium | high
AI_REASONING_EFFORT=low

# Groq  https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Cerebras  https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter (models ending in :free)  https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Mistral (free "Experiment" plan)  https://console.mistral.ai
MISTRAL_API_KEY=
# GitHub Models (a fine-grained token with models:read)  https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=

# Limits per visitor IP. Sheets that were written before are free and don't count.
LABFORGE_AI_DAILY_LIMIT=10
LABFORGE_JOB_TTL_HOURS=24
LABFORGE_MAX_UPLOAD_MB=8
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For.
LABFORGE_TRUST_PROXY=0
# Enables GET /api/admin/usage?token=... (token usage per model). Leave empty to disable.
LABFORGE_ADMIN_TOKEN=

# Running student programs. local = subprocess with a scrubbed environment;
# docker = one locked-down container per run (no network). Use docker in production.
EXEC_BACKEND=local
LABFORGE_EXECUTION_TIMEOUT_SECONDS=12
# Allow web pages being screenshotted to load things from the internet (off: SSRF risk).
HTML_ALLOW_NETWORK=0

# PDF: auto uses Gotenberg if GOTENBERG_URL is set, else a local LibreOffice.
PDF_BACKEND=auto
GOTENBERG_URL=
PDF_CONVERSION_TIMEOUT_SECONDS=120
