# LabForge local configuration example.
# Copy to .env for local development when the backend is implemented.

LABFORGE_ENV=development
LABFORGE_ARTIFACTS_DIR=artifacts
LABFORGE_TEMPLATES_DIR=templates
LABFORGE_DEFAULT_TEMPLATE=chandigarh-university/pblj
LABFORGE_PROFILE_PATH=config/student-profile.example.json
LABFORGE_EXECUTION_TIMEOUT_SECONDS=10
LABFORGE_EXECUTION_NETWORK_DISABLED=true

# AI generation. Use `local` for the deterministic mock provider, or `cloud`
# with a Gemini API key for live content generation.
AI_MODE=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_ATTEMPTS=5
# Comma-separated fallback models used only after retryable Gemini failures.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash

# PDF conversion. `auto` uses Gotenberg when GOTENBERG_URL is set and otherwise
# falls back to a local LibreOffice installation. Servers should set `gotenberg`.
PDF_BACKEND=auto
GOTENBERG_URL=
PDF_CONVERSION_TIMEOUT_SECONDS=120
PDF_MAX_INPUT_BYTES=20971520
