# Copy to .env and fill in what you use. Every AI key below has a free tier;
# set as many as you like and LabForge fails over between them in AI_PROVIDERS order.

# cloud = use the providers below; local = offline mode for development (only
# reads sheets that already contain code, no API calls)
AI_MODE=cloud
# Fastest first. When one is slow (AI_HEDGE_SECONDS) the next starts too; first good answer wins.
AI_PROVIDERS=cerebras,groq,gemini,sambanova,openrouter,nvidia,cloudflare,mistral,github,zai,huggingface,cohere,deepseek
# AI_TIMEOUT_SECONDS=90
# AI_HEDGE_SECONDS=12
AI_MAX_OUTPUT_TOKENS=12000

# Google AI Studio  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=
GEMINI_MAX_ATTEMPTS=2
# low | medium | high, or a token budget like 512. Low keeps thinking tokens near zero.
GEMINI_THINKING=low

# Cloudflare Workers AI through your own proxy Worker (deploy/cloudflare-ai/README.md).
# Free plan: 10,000 neurons a day, about 30 sheets.
CLOUDFLARE_AI_KEY=
CLOUDFLARE_BASE_URL=
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# gpt-oss reasoning effort on Groq, Cerebras and Cloudflare: low | medium | high
AI_REASONING_EFFORT=low

# Cerebras (fastest, free)  https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Groq (very fast, free)  https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# SambaNova Cloud (free)  https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# OpenRouter (models ending in :free)  https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# NVIDIA NIM (free developer access)  https://build.nvidia.com
NVIDIA_API_KEY=
# Mistral (free "Experiment" plan)  https://console.mistral.ai
MISTRAL_API_KEY=
# GitHub Models (a fine-grained token with models:read)  https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=
# Z.ai (GLM Flash models are free)  https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# Hugging Face Inference Providers (small monthly credit)  https://huggingface.co/settings/tokens
HF_INFERENCE_TOKEN=
# Cohere (trial key, about 1,000 calls a month)  https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# DeepSeek (not free, but costs a fraction of a cent per sheet)  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Any of them: <NAME>_MODEL and <NAME>_BASE_URL override the defaults, e.g. NVIDIA_MODEL=...

# Limits per visitor IP. Sheets that were written before are free and don't count.
LABFORGE_AI_DAILY_LIMIT=10
LABFORGE_JOB_TTL_HOURS=24
LABFORGE_MAX_UPLOAD_MB=8
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For.
LABFORGE_TRUST_PROXY=0
# Enables the /admin activity panel and GET /api/admin/usage?token=... Leave empty to disable.
LABFORGE_ADMIN_TOKEN=
# Activity log (who made which report, which programs failed). Without a Postgres URL it goes to
# artifacts/activity.jsonl, which hosts with a wiped disk (Render free) lose on every restart.
LABFORGE_LOG_DB_URL=
LABFORGE_LOG_DAYS=30

# Running student programs. local = subprocess with a scrubbed environment;
# docker = one locked-down container per run (no network). Use docker in production.
EXEC_BACKEND=local
LABFORGE_EXECUTION_TIMEOUT_SECONDS=12
# Allow web pages being screenshotted to load things from the internet (off: SSRF risk).
HTML_ALLOW_NETWORK=0

# PDF: auto uses Gotenberg if GOTENBERG_URL is set, else a local LibreOffice.
PDF_BACKEND=auto
GOTENBERG_URL=
PDF_CONVERSION_TIMEOUT_SECONDS=120
